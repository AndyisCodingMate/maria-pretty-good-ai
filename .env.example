# ---- Twilio ----
# Twilio Account SID and Auth Token (from twilio.com/console)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH=your_twilio_auth_token

# The Twilio phone number that makes the calls (E.164 format)
TWILIO_PHONE_NUMBER=+15551234567

# ---- Groq ----
# Free API key from console.groq.com (used for the AI)
GROQ_API_KEY=your_groq_api_key

# ---- Server ----
# Public tunnel URL to your local server (created automatically by run_all.py)
# Example: https://your-name.trycloudflare.com
# If you set this manually, remember to keep it updated whenever the tunnel restarts. (By default run_all.py already updates this)
SERVER_URL=http://localhost:8000